logging {
  level = "warn"
}

loki.source.file "application" {
  targets = [{ __path__ = "/app/logs/*.jsonl", job = "diabetes" }]
  file_match {
    enabled = true
  }
  forward_to = [loki.process.application.receiver]
}

loki.process "application" {
  stage.json {
    expressions = { service = "service", level = "level", timestamp = "timestamp" }
  }
  stage.labels {
    values = { service = "", level = "" }
  }
  stage.timestamp {
    source = "timestamp"
    format = "RFC3339Nano"
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
